# Copy this file to .env and fill in real values. Never commit .env.

# --- Azure subscription ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=taxipulse-rg
AZURE_REGION=francecentral

# --- Event Hubs ---
AZURE_EVENTHUB_NAMESPACE=taxipulse-eventhub-ns
AZURE_EVENTHUB_NAME=taxi-trips
# Real deployment: the namespace's shared access connection string (or use
# AZURE_EVENTHUB_USE_AAD=true with azure-identity instead, for production).
# Local dev: point this at the local Event Hubs Emulator instead (see
# docker-compose.yml) - exact connection string finalized when the emulator
# is wired up.
AZURE_EVENTHUB_CONNECTION_STRING=

# --- Storage (ADLS Gen2 - Delta Lake raw/staging/marts + Spark checkpoints) ---
AZURE_STORAGE_ACCOUNT=taxipulsemdsdata
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_CHECKPOINTS=checkpoints

# --- Databricks ---
AZURE_DATABRICKS_WORKSPACE_URL=

# --- Replayer ---
REPLAYER_SPEEDUP_FACTOR=60
REPLAYER_INJECT_LATE_RATIO=0.0
REPLAYER_INJECT_DUPLICATE_RATIO=0.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
