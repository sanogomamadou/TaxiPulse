# Copy this file to .env and fill in real values. Never commit .env.

# --- GCP project ---
GCP_PROJECT_ID=taxipulse-mds
GCP_REGION=europe-west1

# --- Pub/Sub ---
PUBSUB_TOPIC_TRIPS=taxi-trips
PUBSUB_TOPIC_TRIPS_DLQ=taxi-trips-dlq
PUBSUB_SUBSCRIPTION_TRIPS=taxi-trips-sub
# Set to emulator host (e.g. localhost:8085) for local dev, leave empty to target real GCP Pub/Sub
PUBSUB_EMULATOR_HOST=

# --- BigQuery ---
BQ_DATASET_RAW=taxipulse_raw
BQ_DATASET_STAGING=taxipulse_staging
BQ_DATASET_MARTS=taxipulse_marts

# --- GCS ---
GCS_BUCKET_RAW=taxipulse-mds-raw-data
GCS_BUCKET_DATAFLOW_TEMP=taxipulse-mds-dataflow-temp

# --- Replayer ---
REPLAYER_SPEEDUP_FACTOR=60
REPLAYER_INJECT_LATE_RATIO=0.0
REPLAYER_INJECT_DUPLICATE_RATIO=0.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
